{
  "name": "code-survivability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "start": "node ./dist/server/entry.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "bun test tests/unit tests/integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun run build && playwright test",
    "test:all": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run test:e2e"
  },
  "dependencies": {
    "@astrojs/node": "latest",
    "@astrojs/solid-js": "latest",
    "astro": "latest",
    "solid-js": "latest",
    "tsx": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/bun": "^1.3.14",
    "@types/node": "latest",
    "eslint": "latest",
    "eslint-plugin-solid": "latest",
    "globals": "latest",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "latest"
  }
}
